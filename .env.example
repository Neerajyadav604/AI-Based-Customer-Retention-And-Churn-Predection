# ==============================================================================
# ChurnGuard — Environment Variables Configuration (.env.example)
# Duplicate this file to .env (or backend/.env and frontend/.env) and update values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
APP_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Database Configuration (MongoDB Atlas for Auth & Profiles)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Optional: Remote MySQL / TiDB Database (Defaults to local SQLite churnguard.db if unset)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
MYSQL_SSL_CA=ca.pem

# AI Chatbot Services (Layer B: LLM Fallback)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Media Storage (Cloudinary for Avatar Photos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (Brevo / Sendinblue for OTP Verification)
BREVO_API_KEY=your_brevo_api_key
MAIL_SENDER_EMAIL=support@churnguard.ai
MAIL_SENDER_NAME=ChurnGuard Security

# Optional: Supabase Client for Cloud Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
